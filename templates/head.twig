{# The head every page of every site gets from Ramonak: title, description, canonical, languages, robots. A site's
   layout includes it: {% include '@ramonak/head.twig' %}. #}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seo.title }}</title>
{% if seo.description %}<meta name="description" content="{{ seo.description }}">
{% endif %}<link rel="canonical" href="{{ seo.canonical }}">
{% for a in seo.alternates %}<link rel="alternate" hreflang="{{ a.lang }}" href="{{ a.url }}">
{% endfor %}{% if seo.x_default %}<link rel="alternate" hreflang="x-default" href="{{ seo.x_default }}">
{% endif %}{% if not seo.indexable %}<meta name="robots" content="noindex, nofollow">
{% endif %}<meta property="og:title" content="{{ seo.title }}">
<meta property="og:url" content="{{ seo.canonical }}">
<meta property="og:locale" content="{{ seo.locale }}">
{% if seo.description %}<meta property="og:description" content="{{ seo.description }}">
{% endif %}{% if seo.jsonld %}<script type="application/ld+json">{{ seo.jsonld|raw }}</script>
{% endif %}
