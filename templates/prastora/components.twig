{# Opt-in Prastora UI adapter. This never replaces @ramonak/head.twig or the CMS operations. #}
{% macro assets(config) %}
  {% set base = config.base|default('') %}
  {% if base %}
    {% if base ends with '/' %}{% set base = base|slice(0, -1) %}{% endif %}
    <link rel="stylesheet" href="{{ base }}/core.css">
    {% for module in config.modules|default([]) %}
      <link rel="stylesheet" href="{{ base }}/modules/{{ module }}.css">
    {% endfor %}
    {% for module in config.enhance|default([]) %}
      <script type="module" src="{{ base }}/modules/{{ module }}.js"></script>
    {% endfor %}
  {% endif %}
{% endmacro %}

{# News pager: Ramonak chooses the published subset and canonical; Twig only renders links. #}
{% macro pagination(pager, path) %}
{% if pager.pages > 1 %}
<nav class="pr-news__pagination" aria-label="News pagination">
  {% if pager.page > 1 %}
    <a rel="prev" href="{{ path }}{% if pager.page > 2 %}?page={{ pager.page - 1 }}{% endif %}">Previous</a>
  {% endif %}
  {% set first = max(1, pager.page - 2) %}
  {% set last = min(pager.pages, pager.page + 2) %}
  {% for number in first..last %}
    <a href="{{ path }}{% if number > 1 %}?page={{ number }}{% endif %}"{% if number == pager.page %} aria-current="page"{% endif %}>{{ number }}</a>
  {% endfor %}
  {% if pager.page < pager.pages %}
    <a rel="next" href="{{ path }}?page={{ pager.page + 1 }}">Next</a>
  {% endif %}
</nav>
{% endif %}
{% endmacro %}

{% macro header(name, home, navigation) %}
<header data-pr-header>
  <div class="pr-header__inner">
    <a class="pr-header__brand" href="{{ home }}">{{ name }}</a>
    {% if navigation|length %}
    <nav class="pr-header__nav" aria-label="Primary">
      <ul>
      {% for link in navigation %}
        <li><a href="{{ link.path }}"{% if link.current|default(false) %} aria-current="page"{% endif %}>{{ link.label }}</a></li>
      {% endfor %}
      </ul>
    </nav>
    {% endif %}
  </div>
</header>
{% endmacro %}

{% macro languages(links) %}
{% if links|length > 1 %}
<details data-pr-languages>
  <summary>
    {% for link in links %}{% if link.current %}{{ link.lang|upper }}{% endif %}{% endfor %}
  </summary>
  <ul>
  {% for link in links %}
    <li><a href="{{ link.path }}" hreflang="{{ link.lang }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.lang|upper }}</a></li>
  {% endfor %}
  </ul>
</details>
{% endif %}
{% endmacro %}

{% macro form(name, definition, lang, back) %}
<form data-pr-form method="post" action="/_ramonak/form/{{ name|url_encode }}">
  <input type="hidden" name="_back" value="{{ back }}">
  {% for key, field in definition.fields|default({}) %}
    {% set type = field.type|default('text') %}
    {% set label = field.label[lang]|default(field.label.en|default(key|capitalize)) %}
    {% if type == 'checkbox' %}
      <div class="pr-form__choice">
        <input type="checkbox" name="{{ key }}" id="{{ name }}-{{ key }}" value="1"{% if field.required|default(false) %} required{% endif %}>
        <label for="{{ name }}-{{ key }}">{{ label }}</label>
      </div>
    {% else %}
      <div class="pr-form__field">
        <label for="{{ name }}-{{ key }}">{{ label }}</label>
        {% if type == 'textarea' %}
          <textarea name="{{ key }}" id="{{ name }}-{{ key }}"{% if field.required|default(false) %} required{% endif %}{% if field.max|default(false) %} maxlength="{{ field.max }}"{% endif %}></textarea>
        {% else %}
          <input type="{{ type }}" name="{{ key }}" id="{{ name }}-{{ key }}"{% if field.required|default(false) %} required{% endif %}{% if field.max|default(false) %} maxlength="{{ field.max }}"{% endif %}>
        {% endif %}
      </div>
    {% endif %}
  {% endfor %}
  {% if definition.honeypot|default('') %}
    <div hidden aria-hidden="true">
      <label for="{{ name }}-trap">Leave blank</label>
      <input type="text" name="{{ definition.honeypot }}" id="{{ name }}-trap" tabindex="-1" autocomplete="off">
    </div>
  {% endif %}
  <button type="submit">Send</button>
</form>
{% endmacro %}

{# Main news card contract: title, date, summary. Site controls optional metadata. #}
{% macro news(entries, options) %}
<div data-pr-news data-l="canvas" data-space="tight">
{% for item in entries %}
  {% set fields = item.fields|default({}) %}
  {% set col = (loop.index0 % 3) * 4 + 1 %}
  {% set published = fields.date|default(item.published_at|date('Y-m-d')) %}
  <article class="pr-news__item" data-x="{{ col }}-{{ col + 3 }}" data-xp="1-4" data-xw="{{ col }}-{{ col + 3 }}">
    {% if options.show_image|default(true) and fields.image|default('') %}
      <img class="pr-news__image" src="{{ fields.image }}" alt="{{ fields.image_alt|default('') }}" loading="lazy">
    {% endif %}
    <div class="pr-news__meta">
      {% if options.show_category|default(false) and fields.category|default('') %}
        <span class="pr-news__category">{{ fields.category }}</span>
      {% endif %}
      <time datetime="{{ published }}">{{ fields.date_label|default(published) }}</time>
    </div>
    <h2><a href="{{ item.path }}">{{ fields.title|default(item.key) }}</a></h2>
    <p class="pr-news__summary">{{ fields.description|default(fields.summary|default('')) }}</p>
    {% if options.show_author|default(false) and fields.author|default('') %}
      <p class="pr-news__byline">{{ fields.author }}</p>
    {% endif %}
    {% if options.show_reading_time|default(false) and fields.reading_minutes|default(false) %}
      <p class="pr-news__byline">{{ fields.reading_minutes }} min read</p>
    {% endif %}
    {% if options.show_comments|default(false) and fields.comments_count is defined %}
      <p class="pr-news__byline">{{ fields.comments_count }} comments</p>
    {% endif %}
  </article>
{% endfor %}
</div>
{% endmacro %}
