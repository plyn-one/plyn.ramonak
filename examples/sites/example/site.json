{
  "key": "example",
  "name": {
    "ru": "Пример",
    "be": "Прыклад",
    "en": "Example"
  },
  "default_language": "ru",
  "indexable": true,
  "domains": {
    "example.test": "primary",
    "www.example.test": "alias"
  },
  "languages": [
    {
      "lang": "ru",
      "prefix": ""
    },
    {
      "lang": "be",
      "prefix": "be"
    },
    {
      "lang": "en",
      "prefix": "en"
    }
  ],
  "kinds": {
    "home": {
      "template": "home.twig",
      "fields": {
        "title": {
          "type": "text",
          "required": true
        },
        "description": {
          "type": "text"
        },
        "body": {
          "type": "html"
        }
      }
    },
    "page": {
      "template": "page.twig",
      "fields": {
        "title": {
          "type": "text",
          "required": true
        },
        "description": {
          "type": "text"
        },
        "body": {
          "type": "html"
        }
      }
    },
    "news": {
      "template": "page.twig",
      "fields": {
        "title": {
          "type": "text",
          "required": true
        },
        "description": {
          "type": "text"
        },
        "date": {
          "type": "date",
          "translate": false
        },
        "body": {
          "type": "html"
        },
        "author": {
          "type": "text",
          "translate": false
        },
        "updated": {
          "type": "date",
          "translate": false
        },
        "source_url": {
          "type": "text",
          "translate": false
        }
      },
      "schema": "NewsArticle"
    },
    "person": {
      "template": "page.twig",
      "schema": "Person",
      "fields": {
        "title": {
          "type": "text",
          "required": true
        },
        "alternate_name": {
          "type": "text"
        },
        "job_title": {
          "type": "text"
        },
        "description": {
          "type": "text"
        },
        "same_as": {
          "type": "list",
          "translate": false
        },
        "body": {
          "type": "html"
        }
      }
    }
  },
  "glossary": {
    "en": [
      {
        "source": "экстрадиция",
        "target": "extradition"
      }
    ]
  },
  "machine_reviews": 2,
  "schema": {
    "organization": {
      "@type": "Organization",
      "name": {
        "ru": "Пример",
        "en": "Example"
      },
      "parentOrganization": {
        "@type": "Organization",
        "name": "Legal Status",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Vilnius",
          "addressCountry": "LT"
        }
      }
    },
    "people": {
      "anna": {
        "name": {
          "ru": "Анна Петрова",
          "en": "Anna Petrova"
        },
        "alternateName": [
          "Анна (Ганна) Петрова"
        ],
        "page": "about",
        "jobTitle": {
          "ru": "Адвокат",
          "en": "Advocate"
        },
        "image": "/assets/anna.webp",
        "sameAs": [
          "https://example.org/anna"
        ]
      }
    }
  },
  "forms": {
    "contact": {
      "title": {
        "en": "Contact form",
        "ru": "Форма связи"
      },
      "notify": [
        "office@example.test"
      ],
      "honeypot": "website",
      "fields": {
        "name": {
          "type": "text",
          "required": true,
          "max": 120,
          "label": {
            "en": "Name",
            "ru": "Имя"
          }
        },
        "contact": {
          "type": "text",
          "required": true,
          "max": 200,
          "label": {
            "en": "Email, phone or messenger",
            "ru": "Email, телефон или мессенджер"
          }
        },
        "message": {
          "type": "textarea",
          "required": true,
          "max": 5000,
          "label": {
            "en": "Message",
            "ru": "Сообщение"
          }
        },
        "consent": {
          "type": "checkbox",
          "required": true,
          "label": {
            "en": "Consent",
            "ru": "Согласие"
          }
        }
      },
      "keep_days": 365
    }
  }
}
