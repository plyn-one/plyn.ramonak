{
    "name": "plyn-one/ramonak",
    "description": "Ramonak: a web engine made first for agents, from a one-page site to a large application.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "twig/twig": "^3.14"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": { "Ramonak\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Ramonak\\Tests\\": "tests/" }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": false,
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --colors=never"
    }
}
